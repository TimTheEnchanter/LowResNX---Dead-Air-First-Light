
GLOBAL GX,GY,GZ,DT,TK,SHD,KILLS,WV,MSGT,NEXTW,PCD,LAS,FLS,SPD,MODE,AUTO
GLOBAL MISSION,MDONE,PC,SCN,TXO,T$,GDQ
GLOBAL DPTR,MP,MW,MT,NVX,NVY,NVZ,NVN,MFL,MHP,HMHP,HNAV,RTM,RQN,FXN,FYN,FZN
GLOBAL INV,TGT,HTGT,HRNG,HHP,GSP,AN2,QCX,QCY,QCZ,IL,IR,IU,ID,IA,IB,STAMP,LASTT,HSHD,HKIL,HWAV,HSPD

GSP=0.75

GAMEPAD 1
DIM GLOBAL YT(96),XT(128),MK(128)
FOR Y=0 TO 95
  YT(Y)=$A000+(Y\8)*256+(Y AND 7)
NEXT Y
YT(96)=$DE00
FOR X=0 TO 127
  XT(X)=(X\8)*16
  MK(X)=2^(7-(X AND 7))
NEXT X
MK(128)=0

P=ROM(1)
NM=PEEK(P)
DIM GLOBAL MFAR(NM-1),MV0(NM-1),MNV(NM-1),MF0(NM-1),MNF(NM-1),ME0(NM-1),MNE(NM-1),MSD(NM-1),MR(NM-1)
TV=0
TF=0
TE=0
FOR M=0 TO NM-1
  Q=P+PEEKW(P+1+M*2)
  MNV(M)=PEEK(Q)
  MNF(M)=PEEK(Q+1)
  MNE(M)=PEEK(Q+2)
  MSD(M)=PEEK(Q+3)
  MR(M)=PEEK(Q+4)/MSD(M)
  MFAR(M)=PEEK(Q+5)
  MV0(M)=TV
  MF0(M)=TF
  ME0(M)=TE
  ADD TV,MNV(M)
  ADD TF,MNF(M)
  ADD TE,MNE(M)
NEXT M
DIM GLOBAL MVX(TV-1),MVY(TV-1),MVZ(TV-1),FNX(TF-1),FNY(TF-1),FNZ(TF-1),FD(TF-1)
DIM GLOBAL EA(TE-1),EB(TE-1),EF1(TE-1),EF2(TE-1)
DIM GLOBAL TX(31),TY(31),TZ(31),SX(31),SY(31),VN(31),FV(31),LE(63)
FOR M=0 TO NM-1
  Q=P+PEEKW(P+1+M*2)+6
  FOR I=0 TO MNV(M)-1
    G=MV0(M)+I
    MVX(G)=PEEK(Q)-128
    MVY(G)=PEEK(Q+1)-128
    MVZ(G)=PEEK(Q+2)-128
    ADD Q,3
  NEXT I
  FOR I=0 TO MNF(M)-1
    G=MF0(M)+I
    FNX(G)=PEEK(Q)-128
    FNY(G)=PEEK(Q+1)-128
    FNZ(G)=PEEK(Q+2)-128
    V=MV0(M)+PEEK(Q+3)
    FD(G)=FNX(G)*MVX(V)+FNY(G)*MVY(V)+FNZ(G)*MVZ(V)
    ADD Q,4
  NEXT I
  FOR I=0 TO MNE(M)-1
    G=ME0(M)+I
    EA(G)=PEEK(Q)
    EB(G)=PEEK(Q+1)
    EF1(G)=PEEK(Q+2)
    EF2(G)=PEEK(Q+3)
    ADD Q,4
  NEXT I
NEXT M
CALL INITGFX
CALL INITSOUND

DIM GLOBAL OT(22),OM(22),OX(22),OY(22),OZ(22),OA(22),OB(22),OC(22),OVA(22),OVC(22)
DIM GLOBAL OHP(22),OST(22),OSTT(22),OCD(22),OCX(22),OCY(22),OCZ(22),OTG(22)
DIM GLOBAL BMT(1),BMX(1),BMY(1),BMZ(1),BNX(1),BNY(1),BNZ(1)
DIM GLOBAL RQS(7),RQT(7)
DIM GLOBAL SA(11),SPX(11),SPY(11),SPZ(11),SVX(11),SVY(11),SVZ(11),SL(11)
DIM GLOBAL DA(23),DPX(23),DPY(23),DPZ(23),DVX(23),DVY(23),DVZ(23),DL(23)
DIM GLOBAL SDX(23),SDY(23),SDZ(23)
DIM GLOBAL RL(11),RR(11),QL(11),QR(11)
DIM GLOBAL PM(8)

RANDOMIZE 11
FOR I=0 TO 23
  Z=RND*2-1
  A=RND*2*PI
  H=SQR(1-Z*Z)
  SDX(I)=H*COS(A)
  SDY(I)=H*SIN(A)
  SDZ(I)=Z
NEXT I

AUTO=PEEK($DF01)

DIM GLOBAL FL(31),DW$(127),PN$(12)
P=ROM(3)
Q=P+1
FOR I=0 TO PEEK(P)-1
  W$=""
  FOR K=1 TO PEEK(Q)
    W$=W$+CHR$(PEEK(Q+K))
  NEXT K
  DW$(I)=W$
  Q=Q+PEEK(Q)+1
NEXT I
TXO=Q-P+2
N$="LT CMDR VOSS/INTELLIGENCE/DR MAREN/MERIDIAN/JUN TELLER/HARROW ONE/DACE ARNO/HARROW THREE/VOSS/MAREN/TELLER/ARNO/UNKNOWN/"
FOR I=0 TO 12
  K=INSTR(N$,"/")
  PN$(I)=LEFT$(N$,K-1)
  N$=RIGHT$(N$,LEN(N$)-K)
NEXT I

DO
  CALL TITLE
  CALL RUNSCRIPT
LOOP

SUB INITGFX
  PALETTE 0,0,14,30,63
  PALETTE 1,0,63,42,21
  PALETTE 2,0,21,42,63
  PALETTE 3,0,48,52,63
  PALETTE 4,0,16,21,42
  COPY $8C00,1024 TO $D000
END SUB

SUB FLIGHTSCREEN
  SCN=0
  BG 0
  BG FILL 0,0 TO 31,31 CHAR 192
  BG 1
  BG FILL 0,0 TO 31,31 CHAR 192
  PAL 0
  FOR R=0 TO 11
    FOR C=0 TO 15
      CELL 2+C,1+R,R*16+C
    NEXT C
  NEXT R
  FILL $8000,3072,0
  FILL $A000,3072,0
  P=ROM(2)
  FOR I=0 TO PEEK(P)-1
    Q=P+1+I*17
    COPY Q+1,16 TO $8000+PEEK(Q)*16
  NEXT I
  BG 0
  PAL 1
  Q=ROM(2)+1+PEEK(ROM(2))*17
  FOR R=0 TO 2
    FOR C=0 TO 3
      F=PEEK(Q+1)
      FLIP F AND 1,(F AND 2)\2
      CELL 8+C,13+R,PEEK(Q)
      ADD Q,2
    NEXT C
  NEXT R
  FLIP 0,0
  SPRITE 0,77,53,195
  SPRITE 0 PAL 2
  FOR I=1 TO 30
    SPRITE I,0,-20,196
    SPRITE I PAL 4
  NEXT I
  FOR I=25 TO 30
    SPRITE I,0,-20,197
    SPRITE I PAL 3
  NEXT I
  FOR I=31 TO 34
    SPRITE I,0,-20,252
    SPRITE I PAL 2
  NEXT I
  FOR I=35 TO 37
    SPRITE I,0,-20,197
    SPRITE I PAL 0
  NEXT I
  SPRITE 38,0,-20,255
  SPRITE 38 PAL 2
  SPRITE 39,0,-20,255
  SPRITE 39 PAL 2
  SPRITE 32 FLIP 1,0
  SPRITE 33 FLIP 0,1
  SPRITE 34 FLIP 1,1
  HSHD=-1
  HKIL=-1
  HWAV=-1
  HSPD=-1
  HTGT=-2
  HRNG=-2
  HHP=-2
  HMHP=-2
  HNAV=-2
END SUB

SUB SCENESCREEN
  SCN=1
  SPRITE OFF 0 TO 63
  PALETTE 0,0,,,
  BG 1
  PAL 5
  BG FILL 0,0 TO 31,31 CHAR 192
  BG 0
  PAL 1
  BG FILL 0,0 TO 31,31 CHAR 192
  COPY $D000,1024 TO $8C00
END SUB

SUB INITSOUND
  SOUND 0,2,4,0
  ENVELOPE 0,0,4,0,3
  SOUND 1,1,,0
  ENVELOPE 1,0,5,0,4
  SOUND 2,3,,0
  ENVELOPE 2,0,9,0,8
  SOUND 3,3,,0
  ENVELOPE 3,0,5,0,4
END SUB


SUB NEWGAME
  GX=0
  GY=0
  GZ=0
  FOR I=0 TO 8
    PM(I)=0
  NEXT I
  PM(0)=1
  PM(4)=1
  PM(8)=1
  SHD=100
  SPD=0.25
  INV=0
  TGT=-1
  KILLS=0
  WV=1
  NEXTW=0
  PCD=0
  LAS=0
  FLS=0
  TK=0
  LASTT=TIMER
  FOR O=0 TO 22
    OT(O)=0
  NEXT O
  DPTR=0
  BMT(0)=0
  BMT(1)=0
  RTM=0
  RQN=0
  FOR I=0 TO 11
    SA(I)=0
    QL(I)=99
    QR(I)=-1
  NEXT I
  FOR I=0 TO 23
    DA(I)=0
  NEXT I
  FOR O=6 TO 9
    OT(O)=2
    OM(O)=2
    CALL PLACEROCK(O,0)
  NEXT O
  IF MISSION=0 THEN CALL SPAWNWAVE
  FILL $A000,3072,0
  FILL $8000,3072,0
END SUB

SUB PLACEROCK(O,F)
  OST(O)=0
  OX(O)=GX+(RND-0.5)*70
  OY(O)=GY+(RND-0.5)*40
  OZ(O)=GZ+(RND-0.5)*70
  IF F THEN
    OX(O)=GX+PM(6)*50+(RND-0.5)*40
    OY(O)=GY+PM(7)*50+(RND-0.5)*20
    OZ(O)=GZ+PM(8)*50+(RND-0.5)*40
  END IF
  OA(O)=RND*6
  OB(O)=RND*6
  OC(O)=RND*6
  OVA(O)=(RND-0.5)*0.04
  OVC(O)=(RND-0.5)*0.05
END SUB

SUB SPAWNWAVE
  NVX=GX+PM(6)*40
  NVY=GY+PM(7)*40
  NVZ=GZ+PM(8)*40
  N=MIN(WV+1,6)
  CALL SPAWNAT(N-N\3*(WV>=3)*-1,0,0)
  IF WV>=3 THEN CALL SPAWNAT(N\3,1,0)
END SUB

SUB UPDATE
  T=TIMER
  DT=MIN(MAX(T-LASTT,1),3)
  LASTT=T
  INC TK
  CALL CONTROLS
  IF IB THEN
    IF IL OR IR THEN
      A=0.04*DT*GSP
      IF IL THEN A=-A
      CALL ROLL(A)
    END IF
    IF IU THEN SPD=MIN(SPD+0.006*DT,0.45)
    IF ID THEN SPD=MAX(SPD-0.006*DT,0.1)
  ELSE
    IF IL OR IR THEN
      A=0.035*DT*GSP
      IF IL THEN A=-A
      CALL TURN(0,A)
    END IF
    IF IU OR ID THEN
      A=0.03*DT*GSP
      IF IU THEN A=-A
      CALL TURN(3,A)
    END IF
  END IF
  IF TK MOD 30=0 THEN CALL ORTHO
  ADD GX,PM(6)*SPD*DT*GSP
  ADD GY,PM(7)*SPD*DT*GSP
  ADD GZ,PM(8)*SPD*DT*GSP
  CALL MOVEENEMIES
  CALL MOVESHOTS
  CALL COLLIDE
  IF MISSION>0 THEN CALL MSTEP
  ADD PCD,-DT
  IF IA AND PCD<=0 AND MODE>=0 THEN
    PCD=8
    LAS=3
    PLAY 0,76,6
    BEST=-1
    BZ=30
    FOR O=0 TO 22
      IF OT(O)=1 OR OT(O)=2 THEN
        Z=OCZ(O)
        R=MR(OM(O))*0.8
        IF Z>0.3 AND Z<BZ AND OCX(O)*OCX(O)+OCY(O)*OCY(O)<R*R THEN
          BEST=O
          BZ=Z
        END IF
      END IF
    NEXT O
    IF BEST<0 THEN
    ELSE IF OT(BEST)=2 THEN
      CALL DEBRIS(BEST,2,0.15)
      PLAY 3,70,4
    ELSE IF BEST>=0 THEN
      DEC OHP(BEST)
      PLAY 3,40,6
      IF OHP(BEST)<=0 THEN CALL KILL(BEST)
    END IF
  END IF
  N=0
  FOR O=0 TO 5
    IF OT(O)=1 THEN INC N
  NEXT O
  IF N=0 AND MISSION=0 THEN
    IF NEXTW=0 THEN NEXTW=120
    ADD NEXTW,-DT
    IF NEXTW<=1 THEN
      NEXTW=0
      INC WV
      SHD=MIN(SHD+25,100)
      CALL SPAWNWAVE
      IF MODE=1 THEN CALL MESSAGE("WAVE "+STR$(WV))
    END IF
  END IF
  CALL RENDER
  CALL STARS
  CALL TARGET
  CALL RADAR
  CALL HUD
  IF MISSION>0 THEN CALL RADIOSTEP
  IF MSGT>0 THEN
    ADD MSGT,-DT
    IF MSGT<=0 THEN TEXT 2,5,"                "
  END IF
  IF INV>0 THEN ADD INV,-DT
  IF FLS>0 THEN
    ADD FLS,-DT
    IF FLS<=0 THEN PALETTE 0,0,,,
  END IF
  POKEW $DF10,TK MOD 65536
  POKE $DF12,MAX(SHD,0)
  POKE $DF13,KILLS MOD 256
  POKE $DF14,WV
  POKE $DF15,MODE
  POKE $DF16,MISSION
  WAIT VBL
END SUB

SUB CONTROLS
  IF MODE=0 OR AUTO THEN
    CALL AUTOPILOT
  ELSE
    IL=LEFT(0)
    IR=RIGHT(0)
    IU=UP(0)
    ID=DOWN(0)
    IA=BUTTON(0,0)
    IB=BUTTON(0,1)
  END IF
END SUB

SUB AUTOPILOT
  IL=0
  IR=0
  IU=0
  ID=0
  IA=0
  IB=0
  BEST=-1
  BD=999999
  FOR O=0 TO 5
    IF OT(O)=1 THEN
      D=OCX(O)*OCX(O)+OCY(O)*OCY(O)+OCZ(O)*OCZ(O)
      IF D<BD THEN
        BD=D
        BEST=O
      END IF
    END IF
  NEXT O
  IF BEST<0 THEN
    IF MISSION=0 THEN EXIT SUB
    CALL TOCAM(NVX,NVY,NVZ)
    X=QCX
    Y=QCY
    Z=QCZ
    IR=X>=0 AND (Z<0.5 OR X>Z*0.03)
    IL=X<0 AND (Z<0.5 OR X<-Z*0.03)
    ID=Z>=0.5 AND Y>Z*0.03
    IU=Z>=0.5 AND Y<-Z*0.03
    SPD=0.45
    IF X*X+Y*Y+Z*Z<625 THEN SPD=0.15
    EXIT SUB
  END IF
  X=OCX(BEST)
  Y=OCY(BEST)
  Z=OCZ(BEST)
  IF Z<0.5 OR ABS(X)>Z THEN
    IR=X>=0
    IL=X<0
  ELSE
    IR=X>Z*0.03
    IL=X<-Z*0.03
    ID=Y>Z*0.03
    IU=Y<-Z*0.03
    R=MR(OM(BEST))*0.8
    IA=Z<30 AND X*X+Y*Y<R*R
  END IF
  IF BD>600 THEN SPD=0.45 ELSE SPD=0.25
END SUB

SUB TURN(K,A)
  C=COS(A)
  S=SIN(A)
  FOR I=0 TO 2
    F=PM(6+I)
    V=PM(K+I)
    PM(6+I)=F*C+V*S
    PM(K+I)=V*C-F*S
  NEXT I
END SUB

SUB ROLL(A)
  C=COS(A)
  S=SIN(A)
  FOR I=0 TO 2
    U=PM(3+I)
    V=PM(I)
    PM(3+I)=U*C+V*S
    PM(I)=V*C-U*S
  NEXT I
END SUB

SUB ORTHO
  CALL UNIT(6)
  PM(0)=PM(4)*PM(8)-PM(5)*PM(7)
  PM(1)=PM(5)*PM(6)-PM(3)*PM(8)
  PM(2)=PM(3)*PM(7)-PM(4)*PM(6)
  CALL UNIT(0)
  PM(3)=PM(7)*PM(2)-PM(8)*PM(1)
  PM(4)=PM(8)*PM(0)-PM(6)*PM(2)
  PM(5)=PM(6)*PM(1)-PM(7)*PM(0)
END SUB

SUB UNIT(K)
  L=SQR(PM(K)*PM(K)+PM(K+1)*PM(K+1)+PM(K+2)*PM(K+2))
  FOR I=K TO K+2
    PM(I)=PM(I)/L
  NEXT I
END SUB

SUB ATN2(Y,X)
  IF X=0 THEN X=0.0001
  AN2=ATAN(Y/X)
  IF X<0 THEN
    IF Y>=0 THEN AN2=AN2+PI ELSE AN2=AN2-PI
  END IF
END SUB

SUB COLLIDE
  IF INV>0 THEN EXIT SUB
  FOR O=0 TO 22
    T=OT(O)
    IF T>0 AND T<>3 AND T<>5 AND T<>7 THEN
      DX=GX-OX(O)
      DY=GY-OY(O)
      DZ=GZ-OZ(O)
      D=DX*DX+DY*DY+DZ*DZ
      R=MR(OM(O))*0.7+0.8
      IF OT(O)<>1 THEN R=MR(OM(O))*0.85+0.8
      IF D<R*R THEN
        INV=40
        IF MODE=1 AND OT(O)<=2 THEN
          FLS=6
          PALETTE 0,32,,,
          IF OT(O)=1 THEN
            ADD SHD,-20
          ELSE IF OM(O)=8 THEN
            ADD SHD,-8
          ELSE
            ADD SHD,-15
          END IF
        END IF
        IF OT(O)=1 THEN
          CALL KILL(O)
        ELSE
          D=SQR(D)+0.001
          GX=OX(O)+DX/D*R
          GY=OY(O)+DY/D*R
          GZ=OZ(O)+DZ/D*R
          SPD=0.1
          PLAY 2,20,20
        END IF
        EXIT SUB
      END IF
    END IF
  NEXT O
END SUB

SUB TARGET
  TGT=-1
  BA=999
  FOR O=0 TO 5
    IF OT(O)=1 THEN
      Z=OCZ(O)
      IF Z>0.5 THEN
        A=(OCX(O)*OCX(O)+OCY(O)*OCY(O))/(Z*Z)
        IF A<BA THEN
          BA=A
          TGT=O
        END IF
      END IF
    END IF
  NEXT O
  SHOWN=0
  IF TGT>=0 THEN
    Z=OCZ(TGT)
    X=64+OCX(TGT)*90/Z
    Y=48-OCY(TGT)*90/Z
    H=MIN(MAX(MR(OM(TGT))*90/Z+2,5),40)
    IF X>=0 AND X<128 AND Y>=0 AND Y<96 THEN
      SHOWN=1
      X0=MAX(INT(X-H),0)+16
      Y0=MAX(INT(Y-H),0)+8
      X1=MIN(INT(X+H),127)+16-7
      Y1=MIN(INT(Y+H),95)+8-7
      SPRITE 31,X0,Y0,252
      SPRITE 32,X1,Y0,252
      SPRITE 33,X0,Y1,252
      SPRITE 34,X1,Y1,252
    END IF
  END IF
  IF SHOWN=0 THEN
    FOR I=31 TO 34
      SPRITE I,0,-20,252
    NEXT I
  END IF
END SUB

SUB MOVEENEMIES
  FOR O=0 TO 22
    T=OT(O)
    IF T=1 AND OTG(O)=4 THEN
      ADD OA(O),0.004*DT*GSP
    ELSE IF T=1 AND OTG(O)=3 THEN
      DX=OX(O)-GX
      DY=OY(O)-GY
      DZ=OZ(O)-GZ
      W=SIN(TK*0.03+O)*0.6
      CALL STEER(O,DX+DZ*W,DY,DZ-DX*W,0.025)
      CALL NOSE(O,0.5)
    ELSE IF T=1 THEN
      HX=GX
      HY=GY
      HZ=GZ
      IF OTG(O)=1 AND OT(10)=3 THEN
        HX=OX(10)
        HY=OY(10)
        HZ=OZ(10)
      END IF
      DX=HX-OX(O)
      DY=HY-OY(O)
      DZ=HZ-OZ(O)
      D=SQR(DX*DX+DY*DY+DZ*DZ)
      RG=6
      IF OTG(O)=1 THEN RG=MR(OM(10))+4
      IF OST(O)=0 THEN
        CALL STEER(O,DX,DY,DZ,0.03)
        IF D<RG THEN
          OST(O)=1
          OSTT(O)=70/GSP
        END IF
      ELSE
        ADD OA(O),0.01*DT*GSP
        OB(O)=OB(O)*0.98
        ADD OSTT(O),-DT
        IF OSTT(O)<=0 THEN OST(O)=0
      END IF
      CALL NOSE(O,0.27-OM(O)*0.04)
      ADD OCD(O),-DT
      IF OST(O)=0 AND D<28 AND OCD(O)<=0 AND MODE>=0 THEN
        IF (FXN*DX+FYN*DY+FZN*DZ)>D*0.985 THEN
          OCD(O)=50+RND*40
          CALL ESHOT(O,FXN,FYN,FZN)
        END IF
      END IF
    ELSE IF T=2 THEN
      ADD OA(O),OVA(O)*DT*GSP
      ADD OC(O),OVC(O)*DT*GSP
      CALL GD(OX(O),OY(O),OZ(O))
      IF OST(O)=0 AND GDQ>4900 THEN CALL PLACEROCK(O,1)
    ELSE IF T=3 THEN
      DX=NVX-OX(O)
      DY=NVY-OY(O)
      DZ=NVZ-OZ(O)
      IF MW=4 THEN
        DX=OX(11)-OX(O)
        DY=OY(11)-OY(O)
        DZ=OZ(11)-OZ(O)
      END IF
      D=SQR(DX*DX+DY*DY+DZ*DZ)
      IF OM(O)=9 THEN
        CALL STEER(O,DX,DY,DZ,0.02)
        IF D>6 THEN CALL NOSE(O,0.2)
      ELSE
        CALL STEER(O,DX,DY,DZ,0.008)
        IF D>14 THEN CALL NOSE(O,0.12)
      END IF
      OC(O)=0
    ELSE IF T=5 THEN
      CALL WINGMAN(O)
    ELSE IF T>=6 THEN
      ADD OA(O),OVA(O)*DT*GSP
      ADD OC(O),OVC(O)*DT*GSP
    END IF
  NEXT O
END SUB

SUB STEER(O,DX,DY,DZ,R)
  CALL ATN2(DX,DZ)
  TB=-ATAN(DY/MAX(SQR(DX*DX+DZ*DZ),0.01))
  W=AN2-OA(O)
  W=W-2*PI*INT((W+PI)/(2*PI))
  RR0=R*DT*GSP
  W=MAX(-RR0,MIN(RR0,W))
  ADD OA(O),W
  ADD OB(O),MAX(-RR0,MIN(RR0,TB-OB(O)))
  OC(O)=OC(O)*0.9-W*8
END SUB

SUB NOSE(O,S)
  CB=COS(OB(O))
  FXN=SIN(OA(O))*CB
  FYN=-SIN(OB(O))
  FZN=COS(OA(O))*CB
  ADD OX(O),FXN*S*DT*GSP
  ADD OY(O),FYN*S*DT*GSP
  ADD OZ(O),FZN*S*DT*GSP
END SUB

SUB WINGMAN(O)
  K=O-12
  BEST=-1
  BD=900
  FOR E=0 TO 5
    IF OT(E)=1 THEN
      DX=OX(E)-OX(O)
      DY=OY(E)-OY(O)
      DZ=OZ(E)-OZ(O)
      D=DX*DX+DY*DY+DZ*DZ
      IF D<BD THEN
        BD=D
        BEST=E
      END IF
    END IF
  NEXT E
  IF BEST>=0 THEN
    DX=OX(BEST)-OX(O)
    DY=OY(BEST)-OY(O)
    DZ=OZ(BEST)-OZ(O)
    CALL STEER(O,DX,DY,DZ,0.035)
    CALL NOSE(O,0.3)
    D=SQR(BD)
    ADD OCD(O),-DT
    IF D<25 AND OCD(O)<=0 AND (FXN*DX+FYN*DY+FZN*DZ)>D*0.97 THEN
      OCD(O)=40+RND*30
      BMT(K)=4
      BMX(K)=OX(O)
      BMY(K)=OY(O)
      BMZ(K)=OZ(O)
      BNX(K)=OX(BEST)
      BNY(K)=OY(BEST)
      BNZ(K)=OZ(BEST)
      DEC OHP(BEST)
      IF OHP(BEST)<=0 THEN CALL KILL(BEST)
    END IF
  ELSE
    SD=6-K*12
    HX=GX+PM(0)*SD-PM(6)*4-PM(3)
    HY=GY+PM(1)*SD-PM(7)*4-PM(4)
    HZ=GZ+PM(2)*SD-PM(8)*4-PM(5)
    DX=HX-OX(O)
    DY=HY-OY(O)
    DZ=HZ-OZ(O)
    D=SQR(DX*DX+DY*DY+DZ*DZ)
    IF D>3 THEN
      CALL STEER(O,DX,DY,DZ,0.04)
      CALL NOSE(O,MIN(SPD+D*0.02,0.6))
    ELSE
      CALL STEER(O,PM(6),PM(7),PM(8),0.04)
      CALL NOSE(O,SPD)
    END IF
  END IF
END SUB

SUB ESHOT(O,FX,FY,FZ)
  FOR I=0 TO 11
    IF SA(I)=0 THEN
      SA(I)=1
      SPX(I)=OX(O)+FX*2
      SPY(I)=OY(O)+FY*2
      SPZ(I)=OZ(O)+FZ*2
      SVX(I)=FX*0.9
      SVY(I)=FY*0.9
      SVZ(I)=FZ*0.9
      SL(I)=60/GSP
      PLAY 1,52,8
      EXIT SUB
    END IF
  NEXT I
END SUB

SUB MOVESHOTS
  FOR I=0 TO 11
    IF SA(I) THEN
      ADD SPX(I),SVX(I)*DT*GSP
      ADD SPY(I),SVY(I)*DT*GSP
      ADD SPZ(I),SVZ(I)*DT*GSP
      ADD SL(I),-DT
      DX=SPX(I)-GX
      DY=SPY(I)-GY
      DZ=SPZ(I)-GZ
      IF DX*DX+DY*DY+DZ*DZ<1.7 THEN
        SA(I)=0
        IF MODE=1 THEN
          ADD SHD,-8
          FLS=4
          PALETTE 0,32,,,
          PLAY 3,20,10
        END IF
      ELSE IF SL(I)<=0 THEN
        SA(I)=0
      ELSE
        IF OT(10)=3 THEN
          DX=SPX(I)-OX(10)
          DY=SPY(I)-OY(10)
          DZ=SPZ(I)-OZ(10)
          R=MR(OM(10))*0.6
          IF DX*DX+DY*DY+DZ*DZ<R*R THEN
            SA(I)=0
            ADD MHP,-4
            IF MHP<=0 THEN
              OT(10)=0
              PLAY 2,20,60
              CALL DEBRIS(10,12,0.6)
            END IF
          END IF
        END IF
        FOR O=6 TO 22
          IF OT(O)=2 THEN
            DX=SPX(I)-OX(O)
            DY=SPY(I)-OY(O)
            DZ=SPZ(I)-OZ(O)
            R=MR(OM(O))*0.8
            IF DX*DX+DY*DY+DZ*DZ<R*R THEN SA(I)=0
          END IF
        NEXT O
      END IF
    END IF
  NEXT I
  FOR I=0 TO 23
    IF DA(I) THEN
      ADD DPX(I),DVX(I)*DT*GSP
      ADD DPY(I),DVY(I)*DT*GSP
      ADD DPZ(I),DVZ(I)*DT*GSP
      ADD DL(I),-DT
      IF DL(I)<=0 THEN DA(I)=0
    END IF
  NEXT I
END SUB

SUB KILL(O)
  IF OTG(O)=3 THEN
    OHP(O)=1
    PLAY 3,30,8
    EXIT SUB
  END IF
  OT(O)=0
  IF MODE=1 THEN INC KILLS
  PLAY 2,30,40
  CALL DEBRIS(O,8,0.5)
END SUB

SUB DEBRIS(O,N,V)
  FOR I=0 TO 23
    IF DA(I)=0 AND N>0 THEN
      DA(I)=1
      DEC N
      DPX(I)=OX(O)
      DPY(I)=OY(O)
      DPZ(I)=OZ(O)
      IF OT(O)=2 THEN
        CALL TOCAM(OX(O),OY(O),OZ(O))
        R=MR(OM(O))*0.8
        DPX(I)=OX(O)-PM(6)*R
        DPY(I)=OY(O)-PM(7)*R
        DPZ(I)=OZ(O)-PM(8)*R
      END IF
      DVX(I)=(RND-0.5)*V
      DVY(I)=(RND-0.5)*V
      DVZ(I)=(RND-0.5)*V
      DL(I)=40+RND*30
      IF V<0.3 THEN DL(I)=12
    END IF
  NEXT I
END SUB

SUB RENDER
  FOR R=0 TO 11
    IF QR(R)>=0 THEN FILL $A000+R*256+QL(R)*16,(QR(R)-QL(R)+1)*16,0
    RL(R)=99
    RR(R)=-1
  NEXT R
  FOR O=0 TO 22
    IF OT(O) THEN CALL DRAWOBJ(O)
  NEXT O
  FOR I=0 TO 1
    IF BMT(I)>0 THEN
      ADD BMT(I),-DT
      CALL STREAK(BMX(I),BMY(I),BMZ(I),BNX(I)-BMX(I),BNY(I)-BMY(I),BNZ(I)-BMZ(I))
    END IF
  NEXT I
  FOR I=0 TO 11
    IF SA(I) THEN CALL STREAK(SPX(I),SPY(I),SPZ(I),-SVX(I)*2.5,-SVY(I)*2.5,-SVZ(I)*2.5)
  NEXT I
  FOR I=0 TO 23
    IF DA(I) THEN CALL STREAK(DPX(I),DPY(I),DPZ(I),DVX(I)*3,DVY(I)*3,DVZ(I)*3)
  NEXT I
  IF LAS>0 THEN
    ADD LAS,-DT
    CALL LINEC(6,95,61,52)
    CALL LINEC(121,95,66,52)
    CALL MARK(6,52,121,95)
  END IF
  FOR R=0 TO 11
    L=MIN(RL(R),QL(R))
    H=MAX(RR(R),QR(R))
    IF H>=0 THEN
      Q=R*256+L*16
      COPY $A000+Q,(H-L+1)*16 TO $8000+Q
    END IF
    QL(R)=RL(R)
    QR(R)=RR(R)
  NEXT R
END SUB

SUB MARK(X0,Y0,X1,Y1)
  IF X1<0 OR X0>127 OR Y1<0 OR Y0>95 THEN EXIT SUB
  A=MAX(X0,0)\8
  B=MIN(X1,127)\8
  FOR R=MAX(Y0,0)\8 TO MIN(Y1,95)\8
    IF A<RL(R) THEN RL(R)=A
    IF B>RR(R) THEN RR(R)=B
  NEXT R
END SUB

SUB GD(X,Y,Z)
  X0=X-GX
  Y0=Y-GY
  Z0=Z-GZ
  GDQ=X0*X0+Y0*Y0+Z0*Z0
END SUB

SUB TOCAM(X,Y,Z)
  X0=X-GX
  Y0=Y-GY
  Z0=Z-GZ
  QCX=X0*PM(0)+Y0*PM(1)+Z0*PM(2)
  QCY=X0*PM(3)+Y0*PM(4)+Z0*PM(5)
  QCZ=X0*PM(6)+Y0*PM(7)+Z0*PM(8)
END SUB

SUB STREAK(X,Y,Z,DX,DY,DZ)
  CALL TOCAM(X,Y,Z)
  IF QCZ<0.5 OR QCZ>60 THEN EXIT SUB
  X0=INT(64+QCX*90/QCZ)
  Y0=INT(48-QCY*90/QCZ)
  CALL TOCAM(X+DX,Y+DY,Z+DZ)
  IF QCZ<0.5 THEN EXIT SUB
  X1=INT(64+QCX*90/QCZ)
  Y1=INT(48-QCY*90/QCZ)
  CALL LINEC(X0,Y0,X1,Y1)
  CALL MARK(MIN(X0,X1),MIN(Y0,Y1),MAX(X0,X1),MAX(Y0,Y1))
END SUB

SUB STARS
  FOR I=0 TO 23
    X=SDX(I)
    Y=SDY(I)
    Z=SDZ(I)
    CZ=X*PM(6)+Y*PM(7)+Z*PM(8)
    SXX=-99
    IF CZ>0.1 THEN
      SXX=INT(64+(X*PM(0)+Y*PM(1)+Z*PM(2))*90/CZ)
      SYY=INT(48-(X*PM(3)+Y*PM(4)+Z*PM(5))*90/CZ)
      IF SXX<0 OR SXX>127 OR SYY<0 OR SYY>95 THEN SXX=-99
    END IF
    IF SXX<0 THEN
      SPRITE 1+I,0,-20,196
    ELSE
      SPRITE 1+I,16+SXX,8+SYY,196
    END IF
  NEXT I
END SUB

SUB RADAR
  FOR O=0 TO 5
    S=25+O
    IF OT(O)=1 THEN
      P=3
      IF O=TGT THEN P=2
      CALL BLIP(S,OCX(O),OCY(O),OCZ(O),P)
    ELSE
      SPRITE S,0,-20,197
    END IF
  NEXT O
  FOR K=0 TO 2
    O=10+K+(K>0)*-1
    S=35+K
    IF OT(O)=3 OR OT(O)=5 THEN
      CALL BLIP(S,OCX(O),OCY(O),OCZ(O),0)
    ELSE
      SPRITE S,0,-20,197
    END IF
  NEXT K
  IF MISSION>0 THEN
    CALL TOCAM(NVX,NVY,NVZ)
    X=QCX
    Y=QCY
    Z=QCZ
    CALL BLIP(38,X,Y,Z,2)
    SX0=-99
    SY0=-99
    IF Z>0.5 THEN
      SX0=INT(64+X*90/Z)
      SY0=INT(48-Y*90/Z)
    END IF
    IF SX0>=3 AND SX0<=124 AND SY0>=3 AND SY0<=92 THEN
      SPRITE 39,16+SX0-3,8+SY0-3,255
    ELSE
      SPRITE 39,0,-20,255
    END IF
  ELSE
    SPRITE 38,0,-20,255
    SPRITE 39,0,-20,255
  END IF
END SUB

SUB BLIP(S,X,Y,Z,P)
  C=197
  IF S=38 THEN C=255
  L=SQR(X*X+Y*Y+Z*Z)+0.001
  X0=X/L
  Y0=Y/L
  IF Z>=0 THEN
    SPRITE S PAL P
    BXX=X0*10
    BYY=-Y0*10
  ELSE
    SPRITE S PAL 4
    H=SQR(X0*X0+Y0*Y0)+0.001
    BXX=X0/H*10
    BYY=-Y0/H*10
  END IF
  SPRITE S,79+INT(BXX)-(C=255)*-2,115+INT(BYY)-(C=255)*-2,C
END SUB

SUB HUD
  IF SHD<>HSHD THEN
    HSHD=SHD
    TEXT 0,0,"SHD"
    N=INT((MAX(SHD,0)+11)/12.5)
    CALL BAR(3,0,N,8)
  END IF
  IF KILLS<>HKIL THEN
    HKIL=KILLS
    TEXT 13,0,"KILL"
    NUMBER 17,0,KILLS,3
  END IF
  IF MISSION=0 THEN
    IF WV<>HWAV THEN
      HWAV=WV
      TEXT 12,13,"WAVE"
      NUMBER 17,13,WV,3
    END IF
  ELSE
    CALL GD(NVX,NVY,NVZ)
    N=NVN*1000+MIN(INT(SQR(GDQ)),999)
    IF N<>HNAV THEN
      HNAV=N
      TEXT 12,13,"NAV"
      IF MW=4 THEN
        TEXT 15,13,"H"
      ELSE IF NVN=0 THEN
        TEXT 15,13,"     "
      ELSE
        NUMBER 15,13,NVN,1
      END IF
      IF NVN=0 THEN TEXT 17,13,"---" ELSE NUMBER 17,13,N MOD 1000,3
    END IF
    N=-1
    IF MFL AND 1 THEN N=MAX(INT((MHP+24)/25),0)
    IF N<>HMHP THEN
      HMHP=N
      IF N>=0 THEN
        IF MFL AND 8 THEN TEXT 0,15,"SHU" ELSE TEXT 0,15,"MER"
        CALL BAR(3,15,N,4)
      END IF
    END IF
  END IF
  N=INT(SPD*1000+0.5)
  IF N<>HSPD THEN
    HSPD=N
    TEXT 0,13,"SPD"
    NUMBER 3,13,N,3
  END IF
  N=-1
  P=0
  IF TGT>=0 THEN
    N=MIN(INT(SQR(OCX(TGT)*OCX(TGT)+OCY(TGT)*OCY(TGT)+OCZ(TGT)*OCZ(TGT))),999)
    P=OHP(TGT)
  END IF
  IF N<>HRNG THEN
    HRNG=N
    TEXT 0,14,"RNG"
    IF N<0 THEN TEXT 3,14,"---" ELSE NUMBER 3,14,N,3
  END IF
  IF TGT<>HTGT OR P<>HHP THEN
    HTGT=TGT
    HHP=P
    IF TGT<0 THEN
      TEXT 12,14,"        "
      TEXT 12,15,"        "
    ELSE
      IF OM(TGT)=10 THEN
        TEXT 12,14,"POST    "
        MX=10
        P=INT((P*4+9)/10)
      ELSE IF OM(TGT)=1 THEN
        TEXT 12,14,"LANCER  "
        MX=4
      ELSE
        TEXT 12,14,"DART    "
        MX=2
      END IF
      MX=MIN(MX,4)
      TEXT 12,15,"HULL"
      CALL BAR(16,15,P,MX)
      IF MX<4 THEN TEXT 18,15,"  "
    END IF
  END IF
END SUB

SUB BAR(X,Y,N,W)
  FOR I=0 TO W-1
    IF I<N THEN CELL X+I,Y,254 ELSE CELL X+I,Y,253
  NEXT I
END SUB

SUB MESSAGE(M$)
  TEXT 2,5,"                "
  TEXT 10-LEN(M$)\2,5,M$
  MSGT=100
END SUB

SUB TITLETEXT(SHOWN,SV)
  IF SHOWN THEN
    TEXT 6,3,"DEAD AIR"
    TEXT 4,5,"FIRST LIGHT"
    IF SV THEN
      TEXT 4,8,"A  NEW GAME"
      TEXT 4,9,"B  CONTINUE"
    ELSE
      TEXT 3,8,"PRESS A TO FLY"
    END IF
    TEXT 7,10,"A FIRE"
    TEXT 5,11,"B+L/R ROLL"
    TEXT 3,12,"B+U/D THROTTLE"
  ELSE
    FOR R=3 TO 12
      TEXT 2,R,"                "
    NEXT R
  END IF
END SUB

SUB MSETUP(N)
  B=ROM(6)
  MP=PEEKW(B+N*2)
  MFL=PEEK(B+MP)
  INC MP
  MW=0
  NVN=0
  NVX=0
  NVY=0
  NVZ=0
  MHP=100
  CALL PLACESHIP(11,4,5,0,-6,-34)
  IF MFL AND 1 THEN
    M=4
    IF MFL AND 8 THEN M=9
    CALL PLACESHIP(10,3,M,14,-5,-12)
  END IF
  IF MFL AND 2 THEN CALL PLACESHIP(12,5,3,6,-1,-4)
  IF MFL AND 4 THEN CALL PLACESHIP(13,5,3,-6,-1,-4)
END SUB

SUB PLACESHIP(O,T,M,X,Y,Z)
  OT(O)=T
  OM(O)=M
  OX(O)=X
  OY(O)=Y
  OZ(O)=Z
  OA(O)=0
  OB(O)=0
  OC(O)=0
  OCD(O)=30
END SUB

SUB MSTEP
  B=ROM(6)
  DO
    IF MW=1 THEN
      CALL GD(NVX,NVY,NVZ)
      IF GDQ>100 THEN EXIT
      MW=0
    ELSE IF MW=2 THEN
      FOR O=0 TO 5
        IF OT(O)=1 THEN EXIT SUB
      NEXT O
      MW=0
    ELSE IF MW=3 THEN
      ADD MT,-DT
      IF MT>0 THEN EXIT
      MW=0
    ELSE IF MW=4 THEN
      CALL GD(OX(11),OY(11),OZ(11))
      IF GDQ<400 THEN MDONE=1
      EXIT
    END IF
    P=B+MP
    OP=PEEK(P)
    IF OP<>2 AND RQN>0 THEN EXIT
    ADD MP,VAL(MID$("64413140033022100",OP,1))
    IF OP=1 THEN
      ADD NVX,PEEK(P+3)-128
      ADD NVY,PEEK(P+4)-128
      ADD NVZ,PEEK(P+5)-128
      INC NVN
      CALL DECODE(PEEKW(P+1))
      CALL MESSAGE(T$)
      MW=1
      K=PEEK(B+MP)
      WHILE K=9 OR K=12 OR K=17
        CALL PLACEOP(B+MP)
        K=PEEK(B+MP)
      WEND
    ELSE IF OP=2 THEN
      CALL RADIO(PEEK(P+1),PEEKW(P+2))
    ELSE IF OP=3 THEN
      CALL SPAWNAT(PEEK(P+1),PEEK(P+2),PEEK(P+3))
    ELSE IF OP=4 THEN
      MW=2
    ELSE IF OP=5 THEN
      MT=PEEKW(P+1)
      MW=3
    ELSE IF OP=7 THEN
      CALL PLACESHIP(14,6,6,(PEEK(P+1)-128)*4,(PEEK(P+2)-128)*4,(PEEK(P+3)-128)*4)
      OVA(14)=0.0015
      OVC(14)=0
    ELSE IF OP=8 OR OP=9 OR OP=12 OR OP=17 THEN
      CALL PLACEOP(P)
    ELSE IF OP=13 THEN
      O=12+PEEK(P+1)
      IF OT(O)=5 THEN
        PLAY 2,24,60
        CALL DEBRIS(O,10,0.5)
        OT(O)=0
      END IF
    ELSE IF OP=14 THEN
      CALL SPAWNAT(1,PEEK(P+1),3)
    ELSE IF OP=15 THEN
      FOR O=0 TO 5
        IF OT(O)=1 AND OTG(O)=3 THEN
          OT(O)=0
          PLAY 2,90,30
          FLS=4
          PALETTE 0,42,,,
        END IF
      NEXT O
    ELSE IF OP=10 OR OP=11 THEN
      CALL FLAGOP(OP-4,P)
    ELSE IF OP=6 THEN
      MW=4
      CALL GD(OX(11),OY(11),OZ(11))
      IF GDQ>6400 THEN
        K=60
        IF OT(14)=6 AND OCZ(14)>0 AND OCZ(14)<250 THEN K=-60
        OX(11)=GX+PM(6)*K
        OY(11)=GY+PM(7)*K-6
        OZ(11)=GZ+PM(8)*K
        CALL ATN2(PM(6),PM(8))
        OA(11)=AN2
      END IF
      NVX=OX(11)
      NVY=OY(11)
      NVZ=OZ(11)
      CALL MESSAGE("RETURN TO HARROW")
    ELSE
      EXIT
    END IF
  LOOP
END SUB

SUB PLACEOP(P)
  OP=PEEK(P)
  IF OP=8 OR OP=9 THEN
    O=-1
    FOR K=9 TO 6 STEP -1
      IF OT(K)<7 THEN O=K
    NEXT K
    IF O>=0 THEN
      IF OP=8 THEN
        CALL PLACESHIP(O,7,7,NVX+2,NVY-1,NVZ+2)
        OVA(O)=0.03
        OVC(O)=0.02
      ELSE
        CALL PLACESHIP(O,8,3,NVX+3,NVY,NVZ+6)
        OB(O)=0.6
        OVA(O)=0.004
        OVC(O)=0.007
      END IF
    END IF
    INC MP
  ELSE IF OP=17 THEN
    O=-1
    FOR K=5 TO 0 STEP -1
      IF OT(K)=0 THEN O=K
    NEXT K
    IF O>=0 THEN
      CALL PLACESHIP(O,1,10,NVX,NVY,NVZ+14)
      OTG(O)=4
      OHP(O)=10
      OST(O)=0
    END IF
    INC MP
  ELSE
    FOR K=1 TO PEEK(P+1)+4
      O=-1
      IF K<=PEEK(P+1) THEN
        O=15+DPTR
        DPTR=(DPTR+1) MOD 8
        CALL PLACESHIP(O,2,8,0,0,0)
      ELSE IF OT(5+K-PEEK(P+1))=2 THEN
        O=5+K-PEEK(P+1)
      END IF
      IF O>=0 THEN
        A=RND*2*PI
        D=7+RND*21
        OX(O)=NVX+COS(A)*D
        OY(O)=NVY+(RND-0.5)*16
        OZ(O)=NVZ+SIN(A)*D
        OA(O)=RND*6
        OB(O)=RND*6
        OVA(O)=(RND-0.5)*0.05
        OVC(O)=(RND-0.5)*0.06
        OST(O)=1
      END IF
    NEXT K
  ADD MP,2
  END IF
END SUB

SUB SPAWNAT(N,M,TG)
  DX=NVX-GX
  DY=NVY-GY
  DZ=NVZ-GZ
  L=SQR(DX*DX+DY*DY+DZ*DZ)+0.01
  FOR K=0 TO N-1
    O=-1
    FOR E=5 TO 0 STEP -1
      IF OT(E)=0 THEN O=E
    NEXT E
    IF O>=0 THEN
      OT(O)=1
      OM(O)=M
      OHP(O)=2+M*2
      D=20+RND*15
      OX(O)=NVX+DX/L*D+(RND-0.5)*24
      OY(O)=NVY+DY/L*D+(RND-0.5)*12
      OZ(O)=NVZ+DZ/L*D+(RND-0.5)*24
      CALL ATN2(GX-OX(O),GZ-OZ(O))
      OA(O)=AN2
      OB(O)=0
      OC(O)=0
      OST(O)=0
      OSTT(O)=0
      OCD(O)=60+RND*60
      OTG(O)=0
      IF TG=1 OR TG=2 AND K MOD 2=1 THEN OTG(O)=1
      IF TG=3 THEN
        OTG(O)=3
        OHP(O)=2
      END IF
    END IF
  NEXT K
END SUB

SUB RADIO(S,ID)
  IF RQN<8 THEN
    RQS(RQN)=S
    RQT(RQN)=ID
    INC RQN
  END IF
END SUB

SUB RADIOSTEP
  IF RTM>0 THEN
    ADD RTM,-DT
    IF RTM<=0 THEN
      FOR R=10 TO 12
        TEXT 0,R,"                    "
      NEXT R
    END IF
  ELSE IF RQN>0 THEN
    S=RQS(0)
    ID=RQT(0)
    FOR I=1 TO RQN-1
      RQS(I-1)=RQS(I)
      RQT(I-1)=RQT(I)
    NEXT I
    DEC RQN
    PAL 2
    TEXT 0,10,PN$(8+S)+":"
    PAL 1
    CALL DECODE(ID)
    K=INSTR(T$,CHR$(1))
    IF K=0 THEN
      TEXT 0,11,T$
    ELSE
      TEXT 0,11,LEFT$(T$,K-1)
      TEXT 0,12,RIGHT$(T$,LEN(T$)-K)
    END IF
    RTM=90+LEN(T$)*2
    PLAY 3,84,3
  END IF
END SUB

SUB TITLE
  CALL FLIGHTSCREEN
  MODE=0
  MISSION=0
  CALL NEWGAME
  SV=PEEK($E000)=70 AND PEEK($E001)=76
  CALL TITLETEXT(1,SV)
  K=0
  REPEAT
    CALL UPDATE
    IF BUTTON TAP(0,0) THEN K=1
    IF SV AND BUTTON TAP(0,1) THEN K=2
  UNTIL K
  CALL TITLETEXT(0,0)
  IF K=2 THEN
    PC=PEEKW($E002)
    FOR I=0 TO 31
      FL(I)=PEEK($E004+I)
    NEXT I
  ELSE
    PC=0
    FOR I=0 TO 31
      FL(I)=0
    NEXT I
  END IF
END SUB

SUB RUNSCRIPT
  S0=ROM(4)
  DO
    P=S0+PC
    OP=PEEK(P)
    ADD PC,VAL(MID$("5333633532115008",OP,1))
    IF OP=1 THEN
      CALL SAY(PEEK(P+1),PEEK(P+2),PEEKW(P+3))
    ELSE IF OP=2 THEN
      CALL SETLOC(PEEKW(P+1))
    ELSE IF OP=3 THEN
      CALL NARRATE(PEEKW(P+1))
    ELSE IF OP=4 THEN
      CALL SHOWCARD(PEEKW(P+1))
    ELSE IF OP=5 THEN
      CALL ASKCHOICE(PEEK(P+1),PEEKW(P+2),PEEKW(P+4),-1)
    ELSE IF OP=16 THEN
      CALL ASKCHOICE(PEEK(P+1),PEEKW(P+2),PEEKW(P+4),PEEKW(P+6))
    ELSE IF OP=6 OR OP=7 THEN
      CALL FLAGOP(OP,P)
    ELSE IF OP=8 OR OP=13 THEN
      F=FL(PEEK(P+1))
      V=PEEK(P+2)
      IF F=V OR OP=13 AND F>V THEN PC=PEEKW(P+3)
    ELSE IF OP=9 THEN
      PC=PEEKW(P+1)
    ELSE IF OP=10 THEN
      CALL FLYMISSION(PEEK(P+1))
    ELSE IF OP=11 THEN
      CALL SAVEGAME
    ELSE
      EXIT
    END IF
  LOOP
END SUB

SUB FLAGOP(OP,P)
  F=PEEK(P+1)
  IF OP=6 THEN FL(F)=PEEK(P+2) ELSE FL(F)=MAX(0,MIN(255,FL(F)+PEEK(P+2)-128))
END SUB

SUB SAVEGAME
  POKE $E000,70
  POKE $E001,76
  POKEW $E002,PC
  FOR I=0 TO 31
    POKE $E004+I,FL(I)
  NEXT I
END SUB

SUB CLR(R)
  CALL ENSURESCENE
  BG 1
  BG FILL 0,R TO 19,15 CHAR 192
  BG 0
  PAL 1
  BG FILL 0,R TO 19,15 CHAR 192
END SUB

SUB ENSURESCENE
  IF SCN=0 THEN CALL SCENESCREEN
END SUB

SUB DECODE(ID)
  B=ROM(3)
  P=B+PEEKW(B+TXO+ID*2)
  T$=""
  C=PEEK(P)
  WHILE C
    IF C>=128 THEN
      T$=T$+DW$(C-128)
    ELSE
      T$=T$+CHR$(C)
    END IF
    INC P
    C=PEEK(P)
  WEND
END SUB

SUB SHOWTEXT(R0,NL)
  BG FILL 0,R0 TO 19,R0+NL-1 CHAR 192
  L$=""
  LN=0
  N=LEN(T$)
  I=1
  WHILE I<=N
    C=ASC(MID$(T$,I,1))
    IF C<=2 THEN
      IF L$<>"" THEN CALL PUTLINE(L$,R0,NL,LN)
      L$=""
      IF C=2 THEN LN=NL
      INC I
    ELSE IF C=32 THEN
      INC I
    ELSE
      J=I
      WHILE J<=N AND MID$(T$,J,1)<>" " AND ASC(MID$(T$,J,1)+" ")>2
        INC J
      WEND
      W$=MID$(T$,I,J-I)
      I=J
      IF L$="" THEN
        L$=W$
      ELSE IF LEN(L$)+1+LEN(W$)<=18 THEN
        L$=L$+" "+W$
      ELSE
        CALL PUTLINE(L$,R0,NL,LN)
        L$=W$
      END IF
    END IF
  WEND
  IF L$<>"" THEN CALL PUTLINE(L$,R0,NL,LN)
END SUB

SUB PUTLINE(L$,R0,NL,LN)
  IF LN>=NL THEN
    CALL WAITA
    BG FILL 0,R0 TO 19,R0+NL-1 CHAR 192
    LN=0
  END IF
  TEXT 1,R0+LN,L$
  INC LN
END SUB

SUB WAITA
  IF AUTO THEN
    WAIT 20
  ELSE
    REPEAT
      IF (TIMER\16) MOD 2 THEN TEXT 18,15,">" ELSE TEXT 18,15," "
      WAIT VBL
    UNTIL BUTTON TAP(0,0)
  END IF
  TEXT 18,15," "
END SUB

SUB SAY(S,E,ID)
  CALL CLR(1)
  Q=ROM(5)+(S*2+E)*580
  PALETTE 5,PEEK(Q),PEEK(Q+1),PEEK(Q+2),PEEK(Q+3)
  COPY Q+4,576 TO $8000
  BG 1
  PAL 5
  FOR R=0 TO 5
    FOR C=0 TO 5
      CELL 1+C,2+R,R*6+C
    NEXT C
  NEXT R
  BG 0
  PAL 1
  TEXT 8,3,PN$(S*2)
  PAL 2
  TEXT 8,5,PN$(S*2+1)
  TEXT 1,8,"------------------"
  PAL 1
  CALL DECODE(ID)
  CALL SHOWTEXT(9,6)
  CALL WAITA
END SUB

SUB NARRATE(ID)
  CALL CLR(1)
  CALL DECODE(ID)
  CALL SHOWTEXT(3,11)
  CALL WAITA
END SUB

SUB SETLOC(ID)
  CALL ENSURESCENE
  CALL DECODE(ID)
  PAL 2
  TEXT 0,0,"                    "
  TEXT 10-LEN(T$)\2,0,T$
  PAL 1
END SUB

SUB SHOWCARD(ID)
  CALL CLR(0)
  CALL DECODE(ID)
  R=6
  PAL 3
  WHILE T$<>""
    K=INSTR(T$,CHR$(1))
    IF K=0 THEN K=LEN(T$)+1
    L$=LEFT$(T$,K-1)
    T$=RIGHT$(T$,MAX(LEN(T$)-K,0))
    TEXT 10-LEN(L$)\2,R,L$
    PAL 1
    R=R+2
  WEND
  CALL WAITA
  BG FILL 0,0 TO 19,15 CHAR 192
END SUB

SUB ASKCHOICE(F,TA,TB,TC)
  CALL ENSURESCENE
  BG FILL 0,9 TO 19,15 CHAR 192
  CALL DECODE(TA)
  TEXT 3,10,T$
  CALL DECODE(TB)
  TEXT 3,12,T$
  N=2
  IF TC>=0 THEN
    CALL DECODE(TC)
    TEXT 3,14,T$
    N=3
  END IF
  K=1
  DO
    FOR I=1 TO N
      TEXT 1,8+I*2," "
    NEXT I
    TEXT 1,8+K*2,">"
    IF AUTO THEN
      WAIT 20
      IF PEEK($DF20+PEEK($DF1F)) THEN K=PEEK($DF20+PEEK($DF1F))
      POKE $DF1F,PEEK($DF1F)+1
      EXIT
    END IF
    WAIT VBL
    IF UP TAP(0) THEN K=K-1+N*(K=1)*-1
    IF DOWN TAP(0) THEN K=K MOD N+1
    IF BUTTON TAP(0,0) THEN EXIT
  LOOP
  FL(F)=K
  BG FILL 0,9 TO 19,15 CHAR 192
END SUB

SUB FLYMISSION(N)
  CALL FLIGHTSCREEN
  MISSION=N
  MODE=1
  CALL NEWGAME
  CALL MSETUP(N)
  MDONE=0
  CALL MESSAGE("LAUNCH")
  REPEAT
    CALL UPDATE
  UNTIL MDONE OR SHD<=0 OR (MFL AND 1)>0 AND MHP<=0
  FL(31)=MAX(SHD,0)
  IF SHD<=0 THEN
    FL(0)=2
    CALL MESSAGE("EJECTING")
  ELSE IF MDONE=0 THEN
    FL(0)=2
    IF MFL AND 8 THEN CALL MESSAGE("SHUTTLE LOST") ELSE CALL MESSAGE("MERIDIAN LOST")
  ELSE
    FL(0)=1
    CALL MESSAGE("LANDING")
  END IF
  FOR I=1 TO 120
    CALL UPDATE
  NEXT I
  MISSION=0
END SUB

SUB DRAWOBJ(O)
  M=OM(O)
  CALL TOCAM(OX(O),OY(O),OZ(O))
  CX=QCX
  CY=QCY
  CZ=QCZ
  OCX(O)=CX
  OCY(O)=CY
  OCZ(O)=CZ
  R=MR(M)
  IF CZ<0.3-R THEN EXIT SUB
  IF ABS(CX)-R*1.23>CZ*0.711 THEN EXIT SUB
  IF ABS(CY)-R*1.14>CZ*0.533 THEN EXIT SUB
  IF R*90<CZ*2.5 THEN
    X=INT(64+CX*90/CZ)
    Y=INT(48-CY*90/CZ)
    IF X>=0 AND X<127 AND Y>=0 AND Y<95 THEN
      Q=YT(Y)+XT(X)
      POKE Q,PEEK(Q) OR MK(X)
      CALL MARK(X,Y,X,Y)
    END IF
    EXIT SUB
  END IF
  IF R*90<CZ*12 AND MFAR(M)<255 THEN M=MFAR(M)
  CA=COS(OA(O))
  SNA=SIN(OA(O))
  CB=COS(OB(O))
  SB=SIN(OB(O))
  CC=COS(OC(O))
  SC=SIN(OC(O))
  R0=CA*CC+SNA*SB*SC
  R1=SNA*SB*CC-CA*SC
  R2=SNA*CB
  R3=CB*SC
  R4=CB*CC
  R5=-SB
  R6=CA*SB*SC-SNA*CC
  R7=SNA*SC+CA*SB*CC
  R8=CA*CB
  K=1/MSD(M)
  P0=PM(0)
  P1=PM(1)
  P2=PM(2)
  M0=(P0*R0+P1*R3+P2*R6)*K
  M1=(P0*R1+P1*R4+P2*R7)*K
  M2=(P0*R2+P1*R5+P2*R8)*K
  P0=PM(3)
  P1=PM(4)
  P2=PM(5)
  M3=(P0*R0+P1*R3+P2*R6)*K
  M4=(P0*R1+P1*R4+P2*R7)*K
  M5=(P0*R2+P1*R5+P2*R8)*K
  P0=PM(6)
  P1=PM(7)
  P2=PM(8)
  M6=(P0*R0+P1*R3+P2*R6)*K
  M7=(P0*R1+P1*R4+P2*R7)*K
  M8=(P0*R2+P1*R5+P2*R8)*K
  E=-MSD(M)*MSD(M)
  QX=(M0*CX+M3*CY+M6*CZ)*E
  QY=(M1*CX+M4*CY+M7*CZ)*E
  QZ=(M2*CX+M5*CY+M8*CZ)*E
  G=MF0(M)
  FOR I=0 TO MNF(M)-1
    FV(I)=FNX(G)*QX+FNY(G)*QY+FNZ(G)*QZ>FD(G)
    INC G
  NEXT I
  INC STAMP
  ST=STAMP
  NE=0
  G=ME0(M)
  FOR I=0 TO MNE(M)-1
    IF FV(EF1(G)) OR FV(EF2(G)) THEN
      LE(NE)=G
      INC NE
      VN(EA(G))=ST
      VN(EB(G))=ST
    END IF
    INC G
  NEXT I
  IF NE=0 THEN EXIT SUB
  B0=999
  B1=999
  B2=-1
  B3=-1
  G=MV0(M)
  FOR V=0 TO MNV(M)-1
    IF VN(V)=ST THEN
      X=MVX(G)
      Y=MVY(G)
      Z=MVZ(G)
      TZ(V)=M6*X+M7*Y+M8*Z+CZ
      TX(V)=M0*X+M1*Y+M2*Z+CX
      TY(V)=M3*X+M4*Y+M5*Z+CY
      IF TZ(V)>=0.3 THEN
        W=90/TZ(V)
        X=INT(64+TX(V)*W)
        Y=INT(48-TY(V)*W)
        SX(V)=X
        SY(V)=Y
        B0=MIN(B0,X)
        B1=MIN(B1,Y)
        B2=MAX(B2,X)
        B3=MAX(B3,Y)
      END IF
    END IF
    INC G
  NEXT V
  FOR I=0 TO NE-1
    G=LE(I)
    A=EA(G)
    B=EB(G)
    IF TZ(A)>=0.3 AND TZ(B)>=0.3 THEN
      CALL LINEC(SX(A),SY(A),SX(B),SY(B))
    ELSE IF TZ(A)>=0.3 OR TZ(B)>=0.3 THEN
      T=(0.3-TZ(A))/(TZ(B)-TZ(A))
      PX=INT(64+(TX(A)+(TX(B)-TX(A))*T)*300)
      PY=INT(48-(TY(A)+(TY(B)-TY(A))*T)*300)
      B0=MIN(B0,PX)
      B1=MIN(B1,PY)
      B2=MAX(B2,PX)
      B3=MAX(B3,PY)
      IF TZ(A)>=0.3 THEN
        CALL LINEC(SX(A),SY(A),PX,PY)
      ELSE
        CALL LINEC(PX,PY,SX(B),SY(B))
      END IF
    END IF
  NEXT I
  IF B2>=0 THEN CALL MARK(B0,B1,B2,B3)
END SUB


SUB LINEC(X0,Y0,X1,Y1)
  XM=ABS(X1-X0)>=ABS(Y1-Y0)
  IF XM THEN
    A0=X0
    B0=Y0
    A1=X1
    B1=Y1
  ELSE
    A0=Y0
    B0=X0
    A1=Y1
    B1=X1
  END IF
  IF A1<A0 THEN
    SWAP A0,A1
    SWAP B0,B1
  END IF
  S=0
  IF A1>A0 THEN S=(B1-B0)/(A1-A0)
  B=B0+0.5
  AL=A0
  AR=A1
  IF ((X0 OR X1 OR Y0 OR Y1) AND -128) OR Y0>95 OR Y1>95 THEN
    LA=95-XM*32
    LB=222.99-LA
    IF A1<0 OR A0>LA THEN EXIT SUB
    AL=MAX(A0,0)
    AR=MIN(A1,LA)
    BM=B-0.01
    IF S>0 THEN
      AL=MAX(AL,-INT(BM/S-A0))
      AR=MIN(AR,-INT(-A0-(LB-B)/S)-1)
    ELSE IF S<0 THEN
      AR=MIN(AR,INT(A0-BM/S))
      AL=MAX(AL,INT(A0+(LB-B)/S)+1)
    ELSE IF B<0.01 OR B>=LB THEN
      EXIT SUB
    END IF
    IF AL>AR THEN EXIT SUB
    ADD B,S*(AL-A0)
  END IF
  IF XM THEN
    FOR X=AL TO AR
      A=YT(B)+XT(X)
      POKE A,PEEK(A) OR MK(X)
      ADD B,S
    NEXT X
  ELSE
    FOR Y=AL TO AR
      A=YT(Y)+XT(B)
      POKE A,PEEK(A) OR MK(B)
      ADD B,S
    NEXT Y
  END IF
END SUB

